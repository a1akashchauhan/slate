# Which model provider to use: gemini (default, free tier) or anthropic
PROVIDER=gemini
# Required for gemini: create a key at aistudio.google.com (no card needed)
GEMINI_API_KEY=
# Required for anthropic: console.anthropic.com (set a monthly spend limit there)
ANTHROPIC_API_KEY=
# Optional overrides
SLATE_MODEL=gemini-3.8-flash
SLATE_MAX_TOKENS=32000
SLATE_PER_HOUR=12
# Comma-separated, e.g. https://slate.vercel.app
ALLOWED_ORIGINS=
